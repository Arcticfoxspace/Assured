# ASSURED environment variables.
# Copy to .env.local for local development:  cp .env.example .env.local
# Every variable is OPTIONAL: the app runs with all of them unset and
# simply turns the matching integration off. Never commit .env.local.
# Only NEXT_PUBLIC_* values are ever visible in the browser.

# ---- Public (safe to expose) -------------------------------------------
NEXT_PUBLIC_APP_NAME=ASSURED
# Full public URL of the deployed site (used in links sent to guardians).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: URLs of separately hosted modules.
NEXT_PUBLIC_ASSURED_HOME_URL=
NEXT_PUBLIC_ASSURED_CYBER_URL=
NEXT_PUBLIC_ASSURED_WOMEN_URL=
NEXT_PUBLIC_ASSURED_TRAVEL_URL=

# ---- Server only: storage ----------------------------------------------
# Supabase project URL and service-role key (SECRET: bypasses row security).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Server only: tokens and scheduler ---------------------------------
# Long random string used to sign guardian links. Generate with:
#   openssl rand -hex 32
SHARE_TOKEN_SECRET=
# Shared secret for /api/cron/alerts. Must match the CRON_SECRET repository
# secret used by .github/workflows/alerts.yml.
CRON_SECRET=

# ---- Server only: routing ----------------------------------------------
# OpenRouteService key. Without it, /api/route returns 501.
ORS_API_KEY=

# ---- Server only: assistant (optional AI labelling) --------------------
# Without a key, Mewvi uses its built-in rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Server only: guardian notifications -------------------------------
# Email via Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# SMS via Twilio (all of these are needed; use FROM or a messaging service).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Server only: Mewvi agent (optional; free providers only) ----------
# off (default) = the deterministic assistant only. shadow = the agent plans and
# counts but replies still come from the deterministic assistant. on = the agent
# answers when it can; any failure falls back to the deterministic reply.
MEWVI_AGENT=off
# Provider order. Only "cloudflare" and "ollama" are recognised (both have free plans).
MEWVI_PROVIDERS=cloudflare,ollama
# Max model calls per day. Per server instance by default; deployment-wide if you also run the
# "Part C" block in supabase/schema.sql (uses the SUPABASE_* values above; SHARE_TOKEN_SECRET adds a per-client cap).
MEWVI_DAILY_BUDGET=300
# Cloudflare Workers AI (primary). Use an API token limited to Workers AI.
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Optional; default is @cf/meta/llama-3.1-8b-instruct-fp8-fast
CF_AI_MODEL=
# Ollama Cloud (optional secondary). The model must be set explicitly.
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Optional. If set, /api/status shows usage counters only to requests that send this value in the x-status-key header.
STATUS_KEY=
